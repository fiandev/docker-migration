# ============================================================
# DOCKER MIGRATION - CONFIGURATION
#
# Copy this file to .env next to main.sh, then fill it in:
#   cp .env.example .env
#   chmod 600 .env
#
# The .env file is read automatically. Variables already exported
# in the shell take precedence over values in this file.
#
# Scheduled backup:
#   sudo ./main.sh install-service
# This installs backup.service + backup.timer (03:00 and 15:00).
# ============================================================

# Bot token from @BotFather.
# Example: 123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Target chat, group, or channel ID.
# Example: 123456789 or -1001234567890
#
# How to find it:
#   1. Send a message to your bot.
#   2. Open:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   3. Copy "message.chat.id".
TELEGRAM_CHAT_ID=

# Optional: forum topic ID, only for groups with topics enabled.
TELEGRAM_TOPIC_ID=

# Send the encrypted chunks and SHA256SUMS to Telegram after backup.
# Telegram Bot API allows at most 50 MB per document, so keep the
# chunk size below that (45m is a safe choice).
#
# To rebuild the archive from downloaded chunks:
#   cat docker-migration-*.part-* > backup.7z
#   sha256sum -c SHA256SUMS
#   7z x backup.7z
TELEGRAM_SEND_FILES=true

# Safety margin for the Telegram file size limit, in MiB.
TELEGRAM_MAX_FILE_MB=49

# Send notifications without sound.
TELEGRAM_SILENT=false

# HTTP timeout for Telegram API calls, in seconds.
TELEGRAM_TIMEOUT=30

# When true, backup/restore fails if Telegram is not configured.
TELEGRAM_REQUIRED=true

# Archive encryption password.
# When set, backup uses this password and does not prompt.
# Required for scheduled/non-interactive backups.
# Leave empty to be prompted interactively.
# Quote the value if it contains spaces or special characters.
BACKUP_PASSWORD=

# Default chunk size when no CLI argument is given.
# The scheduled backup service uses this value.
DEFAULT_CHUNK_SIZE=49m

# Optional overrides.
# WORK_DIR=/root
# ENV_FILE=/path/to/.env
